# Preserve migration snapshot bytes across Windows/macOS checkouts.
data/raw/*.pdf -text
data/processed/* -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Historical outputs retain their original bytes, including model whitespace.
evaluation/results/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Windows batch files need CRLF line endings
*.bat text eol=crlf
