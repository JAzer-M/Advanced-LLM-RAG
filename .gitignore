# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# PyCharm
.idea/

# macOS
.DS_Store

# Environment variables and secrets
.env
.env.*
api.local.json

# Papers and knowledge bases are added by each user and stay local (not published)
data/raw/*
data/processed/*

# Model weights
models/
checkpoints/
*.pt
*.pth
*.safetensors

# Logs
logs/
*.log
!evaluation/results/deepseek_v41/**/*.log
!evaluation/results/rewrite_hyde_20261018/**/*.log

# User-uploaded papers, import jobs and local WebUI library pointer
data/webui/

# Generated desktop bundles and release archives
build/
dist/
releases/

# Exported assistant conversations (kept locally, not published)
docs/chat_history/

# arXiv paper PDFs read during experiments (records keep their text/metadata in JSON)
evaluation/results/**/*.pdf

# Raw acceptance evidence stays local; reports and screenshots are tracked explicitly (git add -f)
docs/maintenance/**
