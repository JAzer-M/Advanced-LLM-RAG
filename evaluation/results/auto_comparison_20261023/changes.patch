+
+class CountingModel:
+    def __init__(self):
+        self.pairs = []
+
+    def predict(self, pairs):
+        self.pairs.extend(pairs)
+        return [float(sum(map(ord, query + text)) % 997) for query, text in pairs]
+
+
+class RerankerCacheTests(unittest.TestCase):
