+def paper_subject(subject):
+    """仅供书目匹配：去掉边缘来源描述，原subject/need仍完整用于证据检查与回答。"""
+    import agent
+    name = agent.normalize(subject)
+    name = re.sub(r'^(?:the\s+)?original(?:\s+|$)', '', name)
+    name = re.sub(r'(?:^|\s+)paper$', '', name)
+    return re.sub(r'^the(?:\s+|$)', '', name).strip()
 
 
